# Base RPC endpoint
RPC_URL=https://mainnet.base.org

# The B20 token this server operates on.
# Defaults to $MEMO on Base mainnet if unset. Human-readable view: https://memogram.pages.dev
# send_memo is PINNED to this address — writes to any other token are refused.
MEMO_TOKEN_ADDRESS=0xB20000000000000000000001BB894FF0C9e82bf3

# Signer key — ONLY needed for send_memo. Leave unset for read-only use.
# SECURITY: use a DEDICATED wallet that never holds meaningful funds.
# MEMO_PRIVATE_KEY=0x...

# Spend caps (send_memo). BOTH ARE REQUIRED whenever MEMO_PRIVATE_KEY is set —
# the server refuses to boot with a signer key and no caps.
# Expressed in human token units; enforced in wei before each send.
#   MEMO_MAX_PER_SEND  max tokens allowed in a single send_memo call
#   MEMO_MAX_TOTAL     max cumulative tokens this server may ever send
# MEMO_MAX_PER_SEND=100
# MEMO_MAX_TOTAL=1000

# Where cumulative spend is journalled. Spend persists across restarts, so
# MEMO_MAX_TOTAL is a lifetime cap and cannot be reset by bouncing the process.
# Delete this file to deliberately reset spend to zero.
# MEMO_SPEND_LEDGER=~/.memo-mcp/spend.json

# Optional: default start block for read_memos caller scans (e.g. the $MEMO deploy block)
# MEMO_FROM_BLOCK=

# Optional: per-request eth_getLogs window. Providers cap this independently of
# the 50000-block safety bound; the public Base RPC allows 10000.
# MEMO_LOG_CHUNK_BLOCKS=10000
